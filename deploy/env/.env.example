# =============================================================================
# OfferPilot - 基础设施环境变量模板
# 用法：cp env/.env.example .env   （.env 放在 deploy 目录下，与 docker-compose.yml 同级）
# 注意：.env 含密码，不要提交到代码仓库
# =============================================================================

# ---------------------------------------------------------------- MySQL 8.0
# 宿主机映射端口：本机已有 MySQL80 占用 3306，故默认用 3307
MYSQL_PORT=3307
MYSQL_DATABASE=yszx
MYSQL_USER=yszx
MYSQL_PASSWORD=yszx_2024
MYSQL_ROOT_PASSWORD=yszx_root_2024

# ------------------------------------------------------------------- Redis 7
REDIS_PORT=6379
REDIS_PASSWORD=yszx_redis_2024
REDIS_MAXMEMORY=512mb

# --------------------------------------------------------------------- MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=yszx_minio
MINIO_ROOT_PASSWORD=yszx_minio_2024
MINIO_BUCKET=yszx
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# 镜像（MinIO 官方镜像已下架，默认用 Bitnami 归档镜像，内置 minio + mc）
# 若你有可用的 minio/minio 镜像源，改成 minio/minio:RELEASE.2024-xx 并把数据目录换回 /data
# MINIO_IMAGE=bitnamilegacy/minio:2024.12.18-debian-12-r0
